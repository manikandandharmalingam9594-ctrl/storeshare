# Store-Share Environment Configuration
# Copy this file to .env and set your custom values.
# NEVER commit your actual .env file or production secrets to Git.

# JWT Secret Key (required: minimum 32 characters recommended)
STORESHARE_JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_chars

# Optional JWT settings
STORESHARE_JWT_ALGORITHM=HS256
STORESHARE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Option A: SQLite (default fallback if STORESHARE_DATABASE_URL is not set)
# STORESHARE_DB_PATH=data/storeshare.db

# Option B: PostgreSQL (set to connect to PostgreSQL)
# STORESHARE_DATABASE_URL=postgresql://storeshare_app:your_password_here@localhost:5432/storeshare
